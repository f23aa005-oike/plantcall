# localmonitor - 環境設定テンプレート
# 外部サービス連携を行う場合は、URLを設定してください。
# 完全オフライン環境（インターネット未接続）で動作させる場合や、連携が不要な場合は空欄のままにしてください。

# Discord Webhook URL (例: https://discord.com/api/webhooks/your_webhook_id/your_webhook_token)
DISCORD_WEBHOOK_URL=

# Google Apps Script (GAS) Webhook URL (例: https://script.google.com/macros/s/your_gas_deployment_id/exec)
GAS_WEBHOOK_URL=
